# ─── Planeación semanal · variables de entorno ───────────────────────────────
# Copie este archivo como .env y ajuste los valores. Nunca versione el .env real.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# ─── Base de datos ───
# Desarrollo local: SQLite (archivo; no requiere instalar nada). Se crea solo.
DATABASE_URL=sqlite:./data/planeacion.db
#
# Servidor: PostgreSQL 16 (ver docs/DATABASE.md y deploy/postgres/01-create-database.sql)
# DATABASE_URL=postgres://planeacion_app:CLAVE@servidor:5432/planeacion?sslmode=verify-full&sslrootcert=/ruta/ca.pem
#   sslmode: disable | prefer | require (cifra) | verify-full (cifra y valida certificado y host)
#
# Solo PostgreSQL:
# Conexiones simultáneas del pool
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECT_TIMEOUT_MS=10000
# true: el servidor aplica las migraciones al iniciar. Con roles separados en producción: false
# (las aplica el rol propietario con "npm run db:migrate").
DB_AUTO_MIGRATE=true

# Zona horaria del equipo: define "hoy" para semanas y vencimientos.
APP_TIMEZONE=America/Bogota
# Solo desarrollo/pruebas: fija la fecha de "hoy" (YYYY-MM-DD). Se ignora en producción.
# APP_TODAY=2026-11-05

# Sesiones
SESSION_TTL_HOURS=12
# true en producción detrás de HTTPS (por defecto: true si NODE_ENV=production)
# COOKIE_SECURE=true
# true si hay un proxy inverso (Caddy/Nginx) que envía X-Forwarded-For
TRUST_PROXY=false
# Orígenes adicionales permitidos para CORS (separados por coma). Vacío = solo el propio.
CORS_ORIGINS=

# Límites
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
# Máximo que registra un cronómetro olvidado (horas)
TIMER_MAX_HOURS=12

LOG_LEVEL=info

# Datos de demostración (solo desarrollo): se cargan con "npm run db:seed"
# o automáticamente al iniciar si la base está vacía y SEED_ON_EMPTY=true.
SEED_ON_EMPTY=true
SEED_ADMIN_PASSWORD=Coordinacion2026
SEED_MEMBER_PASSWORD=Equipo2026

# Producción: primer administrador (npm run user:create-admin)
# ADMIN_EMAIL=coordinacion@suempresa.com
# ADMIN_NAME=Coordinación
# ADMIN_PASSWORD=
